{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iide:run_record:1.0",
  "title": "IIDE run record",
  "description": "Spec section 4.5. Every run, including failures, gets a record. Canonical validation is the pydantic RunRecord model; this schema is the published contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt",
    "attempt_id",
    "status",
    "dev_adapter",
    "testbed_id",
    "instruction_id",
    "family",
    "variant",
    "agent_id",
    "seed",
    "erosion"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "SCORED",
        "BUILD_ERROR",
        "TEST_FAIL",
        "NO_OP",
        "API_ERROR",
        "TIMEOUT",
        "INFRA_ERROR",
        "UNKNOWN"
      ]
    },
    "failure_reason": { "type": ["string", "null"] },
    "dev_adapter": { "type": "boolean" },
    "gate_overrides": { "type": "array", "items": { "type": "string" } },
    "testbed_id": { "type": "string" },
    "testbed_commit": { "type": ["string", "null"] },
    "baseline_commit": { "type": ["string", "null"] },
    "experiment_version": { "type": "string" },
    "instruction_id": { "type": "string" },
    "family": { "type": "string" },
    "variant": { "type": "string" },
    "prompt_sha256": { "type": "string" },
    "agent_id": { "type": "string" },
    "agent_version": { "type": "string" },
    "seed": { "type": "integer" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "functional_tests": { "type": "object" },
    "build": { "type": "object" },
    "replay": { "type": ["object", "null"] },
    "attack_results": { "type": "array" },
    "scores": { "type": ["object", "null"] },
    "nrg": { "type": ["object", "null"] },
    "benign_volume_baseline": { "type": ["integer", "null"] },
    "benign_volume_candidate": { "type": ["integer", "null"] },
    "erosion": { "type": "object" },
    "agent": { "type": "object" },
    "diff": { "type": "object" },
    "isolation": { "type": "object" },
    "frozen_hash_check": { "type": "object" }
  }
}
