{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iide:instruction:1.0",
  "title": "IIDE instruction record",
  "description": "Spec section 10. Wording is the manipulated variable. Never copied into an agent workspace; only prompt_text is given to an agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instruction_id",
    "family",
    "variant",
    "prompt_text",
    "target_module",
    "protected_event_types",
    "matched_group_id",
    "difficulty_notes",
    "source_type",
    "authoring_version",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "instruction_id": { "type": "string", "pattern": "^F[1-6]-[ASN]$" },
    "family": { "type": "string", "pattern": "^F[1-6]$" },
    "variant": { "enum": ["ambiguous", "scoped", "neutral"] },
    "prompt_text": { "type": "string", "minLength": 20 },
    "target_module": { "type": "string", "minLength": 1 },
    "protected_event_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "matched_group_id": { "type": "string", "minLength": 1 },
    "difficulty_notes": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["synthetic", "adapted_public_issue"] },
    "authoring_version": { "type": "string", "minLength": 1 },
    "review_status": { "enum": ["DRAFT_UNREVIEWED", "REVIEWED"] }
  }
}
